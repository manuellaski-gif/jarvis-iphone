# Nur lokale Platzhalter; keine echten Zugangsdaten in Git eintragen.
# Optional: groq oder openai. Ohne Vorgabe wird ein vorhandener Groq-Key,
# sonst ein vorhandener OpenAI-Key verwendet.
AI_PROVIDER=
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
JARVIS_PASSWORD=
PORT=3000
ALLOWED_ORIGINS=https://manuellaski-gif.github.io
# Standard: keine Proxy-Header vertrauen. Nur nach Prüfung der Hosting-Topologie setzen.
TRUST_PROXY=0
