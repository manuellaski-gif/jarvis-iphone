# Nur lokale Platzhalter; keine echten Zugangsdaten in Git eintragen.
# Optional: groq, openai oder gemini. Ohne Vorgabe: Groq, dann OpenAI,
# dann Gemini, jeweils nur mit vorhandenem Schlüssel.
AI_PROVIDER=
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
GEMINI_VOICE=Sulafat
JARVIS_PASSWORD=
PORT=3000
ALLOWED_ORIGINS=https://manuellaski-gif.github.io
# Standard: keine Proxy-Header vertrauen. Nur nach Prüfung der Hosting-Topologie setzen.
TRUST_PROXY=0
